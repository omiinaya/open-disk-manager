# Sensitive top-level configuration - exclude to prevent secret leak
# openclaw.json is now safe to commit (uses ${ENV_VAR} references)
/models.json
/credentials/

# Agent-specific secrets (API keys, auth profiles)
# These files contain provider API keys and credentials
/agents/*/auth-profiles.json
/agents/*/models.json
/agents/*/agent/auth-profiles.json
/agents/*/agent/models.json

# Runtime state that can be regenerated
/exec-approvals.json
/subagents/
/devices/
/identity/
/canvas/
/completions/
/agents/*/sessions/
/cron/runs/

# Logs anywhere
/logs/
*.log

# Temporary and cache
/tmp/
/temp/
node_modules/
dist/
public/
dashboard/

# OpenClaw config backups (contain secrets)
openclaw.json.bak*
openclaw_*.json

# Editor/OS artifacts
.vscode/
.idea/
*.swp
.DS_Store

# Nested git repositories (agent workspaces) - include their files but not their .git
**/.git/

# Built/runtime workspaces
/workspace-harpy/

# Note: Workspace-specific ignores are handled by workspace/.gitignore
# They include: memory/, MEMORY.md, etc.
/.env

# Legacy workspace directories (migrated to agents/)
/workspace-archy/
/workspace-ciel/
/workspace-main/
